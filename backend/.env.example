# Django core
DEBUG=True
SECRET_KEY=replace-with-a-long-random-secret-key

# Production hostnames
# Example: maddheshiya-studio.onrender.com,your-api-domain.com,localhost,127.0.0.1
ALLOWED_HOSTS=maddheshiya-studio.onrender.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://maddheshiya-studio.onrender.com,https://maddheshiya-studio.vercel.app
CORS_ALLOWED_ORIGINS=https://maddheshiya-studio.onrender.com,https://maddheshiya-studio.vercel.app,http://localhost:3000,http://127.0.0.1:3000

# Database
# Production usually uses DATABASE_URL from Render/Railway/Fly/AWS.
# Example: postgres://USER:PASSWORD@HOST:5432/DB_NAME
DATABASE_URL=

# Local PostgreSQL fallback. Used only when DATABASE_URL is empty.
POSTGRES_DB=maddheshiya_studio
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# AWS S3 + CloudFront media storage
AWS_STORAGE_BUCKET_NAME="your-s3-bucket-name"
AWS_S3_REGION_NAME=ap-south-1
AWS_ACCESS_KEY_ID=replace-with-aws-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-aws-secret-access-key

# CloudFront domain only, without https://
# Example: d1234567890abc.cloudfront.net
AWS_S3_CUSTOM_DOMAIN=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email - Postmark SMTP
# Leave POSTMARK_SERVER_TOKEN empty locally to print emails to the console.
POSTMARK_SERVER_TOKEN=
SMTP_FROM=no-reply@maddheshiyastudio.com
SMTP_FROM_NAME=Maddheshiya Studio
