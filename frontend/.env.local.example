# Backend API
# Local example: http://127.0.0.1:8000
# Production example: https://maddheshiya-studio.onrender.com
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# NextAuth
# Local example: http://localhost:3000
# Production example: https://maddheshiya-studio.vercel.app
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-secret

# Google OAuth
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AWS S3 + CloudFront media delivery
NEXT_PUBLIC_AWS_S3_BUCKET=maddheshiya-studio-medias
NEXT_PUBLIC_AWS_REGION=ap-south-1

# CloudFront URL with https://
# Example: https://d1234567890abc.cloudfront.net
NEXT_PUBLIC_AWS_CLOUDFRONT_URL=
